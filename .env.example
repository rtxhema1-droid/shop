# رابط قاعدة بيانات Postgres (مطلوب على Vercel). Neon/Supabase/Vercel Postgres كلهم شغالين.
# لو ضفت Neon من Vercel Marketplace هيتضاف تلقائي باسم DATABASE_URL
DATABASE_URL=postgres://user:password@host/dbname

# حساب المالك (بيتعمل مرة واحدة بس لما الداتابيز تبقى فاضية).
# حط كلمة سر قوية (10 حروف أو أكتر). لو سبتها فاضية هتتولّد كلمة سر عشوائية وتتطبع مرة واحدة في اللوج.
OWNER_USERNAME=owner
OWNER_PASSWORD=

# اختياري: مخزن الصور (Vercel Blob). لو متضبط، الصور الجديدة بتتحول WebP بـ 3 أحجام وتتخزن برا الداتابيز.
# من غيره الصور بتفضل base64 في الداتابيز زي الأول (كله شغال).
BLOB_READ_WRITE_TOKEN=

# رابط الموقع الأساسي (للـ sitemap.xml وروابط المشاركة وصور المعاينة). مهم تضبطه في الإنتاج.
SITE_URL=https://your-domain.com

# اختياري: إشعار واتساب تلقائي للعميل عند تغيير حالة الطلب (واجهة WhatsApp Cloud الرسمية).
# من غيرها بيظهر زرار «أبلغ العميل» برابط wa.me جاهز برسالة معبأة.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# قالب معتمد بـ 3 متغيّرات: {{1}} اسم العميل، {{2}} رقم الطلب، {{3}} الحالة (من غيره بتتبعت رسالة نصية وبتشتغل بس خلال 24 ساعة من آخر رسالة للعميل)
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=ar
