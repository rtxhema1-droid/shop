# رابط قاعدة بيانات Postgres (مطلوب على Vercel). Neon/Supabase/Vercel Postgres كلهم شغالين.
# لو ضفت Neon من Vercel Marketplace هيتضاف تلقائي باسم DATABASE_URL
DATABASE_URL=postgres://user:password@host/dbname

# حساب المالك (بيتعمل مرة واحدة بس لما الداتابيز تبقى فاضية).
# حط كلمة سر قوية (10 حروف أو أكتر). لو سبتها فاضية هتتولّد كلمة سر عشوائية وتتطبع مرة واحدة في اللوج.
OWNER_USERNAME=owner
OWNER_PASSWORD=

# اختياري: مخزن الصور (Vercel Blob). لو متضبط، الصور الجديدة بتتحول WebP بـ 3 أحجام وتتخزن برا الداتابيز.
# من غيره الصور بتفضل base64 في الداتابيز زي الأول (كله شغال).
BLOB_READ_WRITE_TOKEN=
